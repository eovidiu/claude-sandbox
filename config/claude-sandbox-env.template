# Claude Sandbox Configuration
# Copy this file to ~/.claude-sandbox-env and fill in your API keys
# chmod 600 ~/.claude-sandbox-env
#
# This file is read by the sandbox() function to configure MCP servers
# Servers with empty/missing keys will be skipped automatically

# =============================================================================
# MCP Server API Keys
# =============================================================================

# Railway - Deploy and manage infrastructure
# Get your token: https://railway.app/account/tokens
RAILWAY_TOKEN=

# Supabase - Database and backend services (uses cloud-hosted MCP with OAuth)
# Authentication happens via browser when you first use Supabase tools
# Optional: Scope to a specific project (find in Project Settings > General > Project ID)
# SUPABASE_PROJECT_REF=your_project_ref_here

# Context7 - Documentation lookup for libraries
# Get your key: https://context7.com (free tier available)
CONTEXT7_API_KEY=

# =============================================================================
# Optional Git Configuration Overrides
# (Auto-detected from host if not set)
# =============================================================================

# GIT_USER_NAME="Your Name"
# GIT_USER_EMAIL="your@email.com"
