{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudflare-sandbox-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2025-05-06",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "containers": [
    {
      "class_name": "Sandbox",
      "image": "./Dockerfile",
      // "lite" (1/16 vCPU, 256 MiB) is too small for pip installs and scrapers.
      // "basic" is 1/4 vCPU, 1 GiB, 4 GB disk.
      "instance_type": "basic",
      // Allows a few concurrently named sandboxes rather than a single global one.
      "max_instances": 3
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "Sandbox",
        "name": "Sandbox"
      }
    ]
  },
  "migrations": [
    {
      "new_sqlite_classes": ["Sandbox"],
      "tag": "v1"
    }
  ]
}
